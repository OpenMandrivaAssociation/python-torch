TheRock 10.0 (HIP 7.15) no longer ships roctracer's libroctx64. ROCTx
markers are optional (torch.cuda.nvtx / profiler ranges); compute
does not need them. Search lib64 and rocprofiler-sdk-roctx as well,
and stub the bindings when nothing is found.

--- a/cmake/public/LoadHIP.cmake
+++ b/cmake/public/LoadHIP.cmake
@@ -361,8 +361,22 @@
   list(REMOVE_DUPLICATES ROCM_INCLUDE_DIRS)
 
   if(UNIX)
-    # roctx is part of roctracer
-    find_library(ROCM_ROCTX_LIB roctx64 HINTS ${ROCM_PATH}/lib)
+    # roctx was libroctx64 in roctracer; TheRock 7.x/10.0 moved it to
+    # rocprofiler-sdk-roctx. OMV FHS is lib64, not ${prefix}/lib.
+    find_library(ROCM_ROCTX_LIB
+      NAMES roctx64 rocprofiler-sdk-roctx
+      HINTS ${ROCM_PATH}/lib ${ROCM_PATH}/lib64)
+    if(ROCM_ROCTX_LIB)
+      message(STATUS "Found ROCTx: ${ROCM_ROCTX_LIB}")
+      set(USE_ROCTX ON CACHE INTERNAL "ROCTx markers available")
+    else()
+      message(STATUS
+        "ROCTx (libroctx64 / librocprofiler-sdk-roctx) not found — "
+        "torch.cuda.nvtx will be a no-op. Install rocprofiler-sdk-roctx "
+        "to enable markers.")
+      set(USE_ROCTX OFF CACHE INTERNAL "ROCTx markers available")
+      unset(ROCM_ROCTX_LIB CACHE)
+    endif()
 
     set(PROJECT_RANDOM_BINARY_DIR "${PROJECT_BINARY_DIR}")
 
