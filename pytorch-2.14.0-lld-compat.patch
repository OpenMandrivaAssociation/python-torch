--stub-group-size is a BFD-only flag. check_linker_flag can report it
as supported when the compiler driver is clang and the real linker is
LLD, which then rejects the flag. 2.15 already passes
--symbol-ordering-file when CMAKE_LINKER_TYPE is LLD; the spec sets
that. This hunk only skips the stub-group flag on LLD and mold.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -869,12 +869,36 @@
 
 string(APPEND CMAKE_CUDA_FLAGS " -Xfatbin -compress-all")
 
-# Set linker max-page-size to 64KiB on AArch64 Linux
-# And stub group size to 32MiB to workaround R_AARCH64_CALL26
-# relocation errors
+# Set linker max-page-size to 64KiB on AArch64 Linux.
+# GNU ld also needs a larger stub group to work around R_AARCH64_CALL26
+# relocation errors; --stub-group-size is a BFD-only flag (LLD/mold reject
+# it and generate range-extension thunks themselves).
 if(LINUX AND CPU_AARCH64)
   add_link_options_if_supported("-z,max-page-size=0x10000")
-  add_link_options_if_supported("--stub-group-size=0x2000000")
+
+  set(_pytorch_ld_cmd "ld")
+  if(CMAKE_LINKER)
+    set(_pytorch_ld_cmd "${CMAKE_LINKER}")
+  elseif(DEFINED ENV{LD})
+    set(_pytorch_ld_cmd "$ENV{LD}")
+  endif()
+  execute_process(
+    COMMAND ${_pytorch_ld_cmd} --version
+    OUTPUT_VARIABLE _pytorch_ld_ver_out
+    ERROR_VARIABLE _pytorch_ld_ver_err
+    RESULT_VARIABLE _pytorch_ld_ver_rc
+    OUTPUT_STRIP_TRAILING_WHITESPACE
+    ERROR_STRIP_TRAILING_WHITESPACE
+  )
+  set(_pytorch_ld_ver "${_pytorch_ld_ver_out}\n${_pytorch_ld_ver_err}")
+  # check_linker_flag can mis-detect support for BFD-only options when the
+  # compiler driver is used; filter explicitly for LLD/mold.
+  if(_pytorch_ld_ver MATCHES "LLD|mold")
+    message(STATUS
+      "Skipping --stub-group-size (GNU ld only; linker is ${_pytorch_ld_cmd})")
+  else()
+    add_link_options_if_supported("--stub-group-size=0x2000000")
+  endif()
 endif()
 
