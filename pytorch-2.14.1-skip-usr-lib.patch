Do not pass -L/usr/lib or -isystem /usr/include when building HIP
extensions against an FHS ROCm prefix.

ROCm's own prefix keeps libraries in $ROCM_HOME/lib. On an FHS install
ROCM_HOME is /usr, so that path is the 32-bit multilib directory.
/usr/lib/libc.so is a linker script with OUTPUT_FORMAT(elf32-i386);
ld.lld applies it and then rejects every 64-bit object. The 64-bit
libraries are already on the default linker search path.

The same prefix makes include_paths() emit -isystem /usr/include, which
breaks libstdc++ #include_next of stdlib.h and math.h. The CUDA branch
already skips /usr/include. HIP must too.

HIP_HOME is $ROCM_HOME/hip (/usr/hip here), so the library guard has to
cover ROCM_HOME itself. Skip both when the prefix is /usr.

--- a/torch/utils/cpp_extension.py
+++ b/torch/utils/cpp_extension.py
@@ -1799,7 +1799,12 @@ def include_paths(device_type: str = "cpu", torch_include_dirs=True) -> list[str
         ])
     if device_type == "cuda" and IS_HIP_EXTENSION:
         paths.append(os.path.join(lib_include, 'THH'))
-        paths.append(_join_rocm_home('include'))
+        # FHS ROCm lives in /usr. -isystem /usr/include breaks libstdc++
+        # #include_next <stdlib.h> and <math.h>. The CUDA branch already
+        # skips this; HIP must too.
+        rocm_include = _join_rocm_home('include')
+        if rocm_include != '/usr/include':
+            paths.append(rocm_include)
     elif device_type == "cuda":
         cuda_home_include = _join_cuda_home('include')
         # if we have the Debian/Ubuntu packages for cuda, we get /usr as cuda home.
@@ -1838,9 +1843,13 @@ def library_paths(device_type: str = "cpu", torch_include_dirs: bool = True, cr
         paths.extend([TORCH_LIB_PATH])
 
     if device_type == "cuda" and IS_HIP_EXTENSION:
-        lib_dir = 'lib'
-        paths.append(_join_rocm_home(lib_dir))
-        if HIP_HOME is not None:
+        # /opt/rocm keeps its libraries in $ROCM_HOME/lib. When ROCm is
+        # installed into /usr, that directory is the 32-bit multilib dir.
+        # /usr/lib is already on the linker search path, and adding it
+        # selects /usr/lib/libc.so (OUTPUT_FORMAT(elf32-i386)).
+        if ROCM_HOME != '/usr':
+            paths.append(_join_rocm_home('lib'))
+        if HIP_HOME is not None and HIP_HOME != '/usr':
             paths.append(os.path.join(HIP_HOME, 'lib'))
     elif device_type == "cuda":
         if cross_target_platform == "windows":
@@ -2640,7 +2647,10 @@ def _prepare_ldflags(extra_ldflags, with_cuda, with_sycl, verbose, is_standalone
                 extra_ldflags.append(f'/LIBPATH:{_join_rocm_home("lib")}')
                 extra_ldflags.append('amdhip64.lib')
