+def gen_lld_symbol_ordering(filein: str) -> str:
+    """
+    LLD: order input sections by hot symbol names.
+
+    ``prioritized_text.txt`` already lists mangled symbols; with
+    ``-ffunction-sections`` each lives in ``.text.<sym>`` and LLD's
+    ``--symbol-ordering-file`` places them early in the image.
+    """
+    symbols = _read_prioritized_symbols(filein)
+    if not symbols:
+        raise RuntimeError(f"No symbols found in {filein}")
+    return f"-Wl,--symbol-ordering-file={filein}"
+
+
+def gen_mold_section_ordering(filein: str, fout: str) -> str:
+    """
+    mold: ``--section-ordering-file`` with ``.text.<sym>`` section names
+    (same naming as the BFD script path under ``-ffunction-sections``).
+    """
+    symbols = _read_prioritized_symbols(filein)
+    if not symbols:
+        raise RuntimeError(f"No symbols found in {filein}")
+
+    fout_path = Path(fout)
+    if fout_path.suffix == ".ld":
+        fout_path = fout_path.with_name("section_ordering.txt")
+    fout_path.parent.mkdir(parents=True, exist_ok=True)
+    with open(fout_path, "w") as f:
+        for sym in symbols:
+            f.write(f".text.{sym}\n")
+    return f"-Wl,--section-ordering-file={fout_path}"
+
