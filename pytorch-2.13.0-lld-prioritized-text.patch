+def detect_linker_flavor(ld: Optional[str] = None) -> str:
+    """
+    Classify the linker used for prioritized-text layout.
+
+    Returns one of: ``lld``, ``mold``, ``bfd``, ``unknown``.
+    """
+    ld = ld or os.environ.get("LD", "ld")
+    text = _linker_version_text(ld)
+    if not text:
+        return "unknown"
+    head = text.splitlines()[0] if text.splitlines() else text
+    head_l = head.lower()
+    full_l = text.lower()
+    # LLD (including distro wrappers that put "LLD" on the first line).
+    if re.search(r"\blld\b", head_l) or re.search(r"\blld\b", full_l[:200]):
+        return "lld"
+    if "mold" in head_l:
+        return "mold"
+    if "gnu ld" in full_l or "gnu binutils" in full_l:
+        return "bfd"
+    # gold still supports a default script dump via -verbose in some builds.
+    if "gnu gold" in full_l or head_l.startswith("gnu gold") or " gold " in head_l:
+        return "bfd"
+    return "unknown"
