+def gen_linker_script(
+    filein: str = "cmake/prioritized_text.txt",
+    fout: str = "cmake/linker_script.ld",
+    ld: Optional[str] = None,
+) -> str:
+    """
+    Prepare prioritized-text link flags for the active linker.
+
+    Returns the flag string for shared/module linker flags
+    (e.g. ``-T...`` or ``-Wl,--symbol-ordering-file=...``).
+    Prints ``PRIORITIZED_TEXT_LINKER_FLAG=...`` on stdout for CMake.
+    """
+    ld = ld or os.environ.get("LD", "ld")
+    flavor = detect_linker_flavor(ld)
+
+    if flavor == "lld":
+        flag = gen_lld_symbol_ordering(filein)
+        strategy = "symbol-ordering (lld)"
+    elif flavor == "mold":
+        flag = gen_mold_section_ordering(filein, fout)
+        strategy = "section-ordering (mold)"
+    else:
+        # GNU ld / gold / unknown: BFD-style default script injection.
+        # _resolve_bfd_ld tries ld.bfd when default ld cannot dump a script.
+        try:
+            flag = gen_bfd_linker_script(filein, fout, ld)
+            strategy = f"bfd-script ({flavor})"
+        except RuntimeError:
+            # Last resort on LLD-as-ld systems with odd version strings.
+            if shutil.which("ld.lld") or "lld" in os.path.basename(ld):
+                flag = gen_lld_symbol_ordering(filein)
+                strategy = "symbol-ordering (fallback)"
+            else:
+                raise
+
+    print(f"-- prioritized text linker strategy: {strategy}", file=sys.stderr)
+    print(f"PRIORITIZED_TEXT_LINKER_FLAG={flag}")
+    return flag
