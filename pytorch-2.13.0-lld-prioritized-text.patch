+def _can_dump_default_script(ld: str) -> bool:
+    """True if ``ld -verbose`` emits a GNU-style default linker script."""
+    try:
+        proc = subprocess.run(
+            [ld, "-verbose"],
+            check=False,
+            capture_output=True,
+            text=True,
+            timeout=60,
+        )
+    except (FileNotFoundError, OSError, subprocess.TimeoutExpired):
+        return False
+    out = proc.stdout or ""
+    if proc.returncode != 0:
+        return False
+    return out.count("==================================================") >= 2
